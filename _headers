/downloads/*
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/pdf
  Content-Disposition: attachment
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex

/legal/*.txt
  Content-Type: text/plain; charset=utf-8
  Content-Disposition: attachment
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex
